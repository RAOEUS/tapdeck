{
  "manifest_version": 3,
  "name": "Tapdeck",
  "version": "0.2.0",
  "description": "Real-time audio processing for any browser tab: a rack of parametric EQ, compressor, multiband, limiter and utility with live FabFilter-style visualization.",
  "permissions": ["tabCapture", "offscreen", "activeTab", "storage", "tabs"],
  "icons": { "16": "icons/idle-16.png", "32": "icons/idle-32.png", "48": "icons/idle-48.png", "128": "icons/idle-128.png" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tapdeck",
    "default_icon": { "16": "icons/idle-16.png", "32": "icons/idle-32.png", "48": "icons/idle-48.png", "128": "icons/idle-128.png" }
  },
  "options_ui": {
    "page": "editor.html",
    "open_in_tab": true
  }
}
